# =============================================================================
# Molde — copie para .env na raiz do repositorio.
#
# UM arquivo so, usado pelo worker e pelo Next (o next.config.ts carrega este
# mesmo arquivo). Nunca versione o .env de verdade.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Painel do Supabase > Project Settings > API Keys.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# A chave SECRETA (comeca com sb_secret_). Ela ignora RLS, entao nunca pode
# chegar ao browser — por isso o nome nao tem o prefixo NEXT_PUBLIC_, e nao deve
# ganhar um. Nao confunda com a publishable/anon, que o projeto nao usa.
SUPABASE_SECRET_KEY=

# Se o seu projeto ainda usa a chave legada (aba "Legacy API Keys" > service_role),
# preencha esta no lugar da de cima. Tanto faz qual das duas: o codigo aceita as
# duas, e este e tambem o nome que a integracao da Vercel injeta sozinha.
SUPABASE_SERVICE_ROLE_KEY=

# --- Acesso ao app -----------------------------------------------------------
# Usuario unico: uma senha, sem cadastro e sem recuperacao.
APP_PASSWORD=

# Segredo que assina o cookie de sessao. Gere com:
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
# Trocar este valor desloga voce de todos os dispositivos.
SESSION_SECRET=

# --- APIs de IA (a partir da Fase 1) -----------------------------------------
# Transcricao: Whisper via Groq (whisper-large-v3-turbo). Camada gratuita, sem
# cartao, cobre 8 horas de audio por dia.
GROQ_API_KEY=

# Analise e estruturacao do roteiro. O provedor ativo e escolhido em
# packages/config (models.analysis) — so a chave dele precisa estar preenchida.
#
# PADRAO: Gemini (Google AI Studio). Gratuito, sem cartao, com visao nativa.
# Pegue em aistudio.google.com/apikey
GEMINI_API_KEY=

# Alternativa gratuita: reaproveita a GROQ_API_KEY acima, sem conta nova.
# So aceita 5 imagens por requisicao, entao a analise visual fica mais rasa.
#
# Alternativas pagas:
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# --- Instagram (coleta de perfil) --------------------------------------------
# A fonte ativa e escolhida em packages/config (collection.source).
#
# Padrao: 'graph' — API oficial, Business Discovery. Risco ZERO para a sua conta
# e roda em qualquer lugar, inclusive no GitHub Actions.
#
# O token sai do painel do Meta (developers.facebook.com), e o user id e o da SUA
# conta profissional do Instagram — nao o do perfil que voce quer analisar.
IG_GRAPH_TOKEN=
IG_GRAPH_USER_ID=

# Se voce trocar para 'scraper', nada aqui e usado: a coleta passa a depender da
# sessao gravada por `npm run login`, e o worker precisa rodar numa maquina sua.

# --- Ligar o worker sozinho (opcional, mas recomendado) ----------------------
# Sem isto, todo trabalho fica parado na fila ate voce abrir o GitHub e apertar
# "Run workflow" na mao. Com isto, enfileirar ja liga o worker.
#
# Estas duas vao nas variaveis de ambiente da VERCEL (nao nos secrets do GitHub):
#
#   GITHUB_TOKEN  um fine-grained token com permissao "Actions: Read and write"
#                 no repositorio clonandosucesso
#   GITHUB_REPO   dono/repositorio
GITHUB_TOKEN=
GITHUB_REPO=vitohferreira/clonandosucesso

# --- Worker ------------------------------------------------------------------
# Onde ficam sessao do navegador, logs e midia temporaria.
# Vazio = apps/worker/data. No container o compose troca para /data.
MOLDE_DATA_DIR=

# Linux: faz os arquivos gerados pelo container pertencerem a voce, e nao a root.
#   export MOLDE_UID=$(id -u) MOLDE_GID=$(id -g)
MOLDE_UID=1000
MOLDE_GID=1000
